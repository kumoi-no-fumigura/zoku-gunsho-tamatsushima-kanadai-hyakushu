    197,
    223
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "末の原はるたつ花をかつみせてたなひきそむる朝かすみかな",
   "kana": "",
   "speaker": "義政・",
   "page": 3,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "和歌部二十一ああさかすみ"
  },
  {
   "seq": "2",
   "text": "さして日の影はくもらぬあさ霞ひかりやかわす玉つしま山",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あさかすみ",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "かきくもり又雪ふゝくたかねもさすかまされぬ朝霞か霞かな",
   "kana": "",
   "speaker": "勝光",
   "page": 3,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あさかすみ",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "すきたてるみわの山もとそことしもみえぬはかりのあさ霞かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "すあさかすみ",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "みよし野やおくふかくなか朝はすみ花にわくへきみねとみなから",
   "kana": "",
   "speaker": "為富",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "みあさかすみ",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "むかしたか袖ふれぬれはむめのはな人よりふかきかほりなるらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "むむめのはな",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "めくりあふちきりはふかき梅のはなそれそとみゆるやとのしるしに",
   "kana": "",
   "speaker": "親長",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "め一むめのはな親長"
  },
  {
   "seq": "8",
   "text": "軒ちかくまれうへをきて梅のはなかほひへたてぬ神の玉かき",
   "kana": "",
   "speaker": "教秀",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "のむめのはな",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "春へとはにほひにしるし梅の花ふりし難波の里もかはらて",
   "kana": "",
   "speaker": "綱光",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一むめのはな綱光",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "なへて世にふれる雪かとさく梅の花もさかりや久かたの空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "なむめのはな",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "たむけつゝいのることみの玉やなき神やめくみの露をかけまし",
   "kana": "",
   "speaker": "季春",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "たまやなき",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "まゆひらくみとりの色に置露のこほれてなひく玉柳かな",
   "kana": "",
   "speaker": "玄就",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "にたまやなき玄就",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "やそうちやあせになひくたま柳きしうつ浪に露そくたくる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "やたまやなき雅行",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "なへてをくめくみの露のたま柳糸につらぬく数みゆるまて",
   "kana": "",
   "speaker": "雅楽",
   "page": 4,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "なたまやなき雅康",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "岸か気やう地いつる浪のたにやなきはるのひかりにまゆひらくらし",
   "kana": "",
   "speaker": "教国",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "したまやなき",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "河かせに浪もくたけてむらさきの花につゆちるかきつはた哉",
   "kana": "",
   "speaker": "之親",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "かきつはた之親",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "きゝわたるそのやつはしのかきつはた花もいく代をかけてさくらむ",
   "kana": "",
   "speaker": "賢盛",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "まかきつはた賢盛",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "露のほる池のみきそのかきつはた花にいろそふ夕くれのあめ",
   "kana": "",
   "speaker": "永継",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "川かきつはた永継",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "はる〳〵ときつゝなかめしかきつはたたゝこみの葉の花にさくらし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "かきつはた貞隆",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "時にあへること葉の花の色そへてなをとこ夏にたれか見さらむ",
   "kana": "",
   "speaker": "つ賢盛",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "たかきつはた哥闕ほとゝきす哥五首闕ととこな"
  },
  {
   "seq": "21",
   "text": "このねぬるあさ筆の露やさくまゝの色にをき出るとこ夏のはな",
   "kana": "",
   "speaker": "限度",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "名にをはぬ草はなけれと花の色のとこなつかしき庭のあさあけ",
   "kana": "",
   "speaker": "為富",
   "page": 5,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ななとこなつ",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "つゆもなをにほひをそへて見るまゝにはしゐになれること夏のみろ",
   "kana": "",
   "speaker": "光種",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "つとこなつ",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "葉かくれに花たちはなのなり行や枝もたわらにしけりそふらむ",
   "kana": "",
   "speaker": "長恒",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ははなたちはなはなたちはな長恒"
  },
  {
   "seq": "25",
   "text": "なれ〳〵て花橘のいく千代の枝さしかはす軒の松かけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "はなたちはな貞秀",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "たか世より誰袖ふれしかほひともはなたちむにそはこたへよ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "はなたちはな雅康",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "千里まて匂やしるくをくるらんはなたちはなにかよふ夕かせ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "はなたちはな明宣",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "はらひつゝちりをきよむる庭の四に花たちはなの露そ玉しく",
   "kana": "",
   "speaker": "長興",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ははなたちはなはなたちはな長興"
  },
  {
   "seq": "29",
   "text": "なからへてわれもむかしをしのふ草おふてふ軒の花たちはなに",
   "kana": "",
   "speaker": "為富・",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "なはなたちはな",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "女郎花お月ある野人の露ををも見なひくこゝろは誰おもふらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ををみなへし明茂",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "身にそしむ露もさなからをみなへし吹みたりたる野への秋かせ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見をみなへし",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "名にしほふ花としみれはをみなへしなひくすかたの色にめてつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "なをみなへし教秀",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一敷てゆく野も世の霧のは重かきにたかつまこむるをみなへしそも",
   "kana": "",
   "speaker": "教国",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "へをみなへし",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "しら露のおくとはなけきぬるとなく風にしたかふをみなへしかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "しをみなへし雅康",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "はる〳〵となひく末のゝはなすゝき袖うちかはしゆくかたそみる",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "はなすらき義政",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "すゑとをく分ゆく野への秋風をまねきもとめぬ花すゝきかな",
   "kana": "",
   "speaker": "季春",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "なはなすゝき歌闕はなすゝき"
  },
  {
   "seq": "37",
   "text": "霧ふかき籬も露のひかりよりあらはになひく花すゝきかな",
   "kana": "",
   "speaker": "き為信",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "すはなすゝき奇欠しはなすゝ"
  },
  {
   "seq": "38",
   "text": "ふるさとの秋をわすれすきてみれは露をかきぬるふちはかまかな",
   "kana": "",
   "speaker": "親長",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ふふちはかま親長",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "千種さく野をきてとへは藤はかまはるみし花の名はのこりけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "りふ地はかま綱光",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "はらひかね分つゝ行やふちはかますそ野の露のしほとそふらん",
   "kana": "",
   "speaker": "其就",
   "page": 7,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "はふちはかま玄然か"
  },
  {
   "seq": "41",
   "text": "かすにもにほひはしるし藤はかまなをおなし野の露のゆかりに",
   "kana": "",
   "speaker": "英基",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一ふちはかま英台",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "真葛はもましる野もせの藤はる浦吹かせにほころひぬらし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ふちはかま顕豪",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "初忘くれ檜原かおくの下露にかつ色見ゆるはしもみちかな",
   "kana": "",
   "speaker": "元親",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "はしもみち元親",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "しくれてそそれとしらるゝはしも声常盤の木のましみ山に",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "しはしもみ地",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "もる程もした枝に見へて露時雨はやそめわたすはし紅葉哉",
   "kana": "",
   "speaker": "中薫",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一はしもみち中薫",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "みるかうちにいろこきませて夕日影くれ行やまのはしもみち哉",
   "kana": "",
   "speaker": "為富",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見はしもみち為冨",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "ちるそめやむかひの岡のはし紅葉たちえあらはに秋風そふく",
   "kana": "",
   "speaker": "長恒",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "はしもみち",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "浜木綿のまたひとへたにつもらねは気にはつ雪とみくまのゝうら",
   "kana": "",
   "speaker": "雅康",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ははつゆき",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "つもるらむ風は音せすさゆる夜の明ほのみやき松のはつ雪",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "つはつゆき元為",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "ゆふくれにさえつる風の音よはくきしよりつもる夜半の初雪",
   "kana": "",
   "speaker": "貞秀",
   "page": 8,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ゆはつゆき",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "昨日見し野原の霜の気ぬかかへに又ふりそふやけさのみつ雪",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "やはつゆき雅行",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "をやみなき雪のよそめはかきくもり気ふりをうつむをあらすみかま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ををのらすみかま季春"
  },
  {
   "seq": "53",
   "text": "のこりなくうつめる雪の山か気もけふかやしるへをのゝすみかま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "をのゝすみかま賢盛"
  },
  {
   "seq": "54",
   "text": "一軒はより雪にむかへは里々のけふりもにほすをのゝすみかれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "のをのゝすみかま政孝"
  },
  {
   "seq": "55",
   "text": "すみのほる月に山かせをとふ気てけふりそうすきをのゝすみかま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "すをのゝすみかま之種"
  },
  {
   "seq": "56",
   "text": "見やこにと此ころはこふみ地とをみたえすもや〳〵かに野のすみかま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "をのゝすみかま教秀"
  },
  {
   "seq": "57",
   "text": "かきくらしふる雪まよりたちつゝく気ふりそほそき小野の炭かま",
   "kana": "",
   "speaker": "永継",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "をのゝすみかま永継"
  },
  {
   "seq": "58",
   "text": "ま柴多く煙とみゆる一方や雪にこもれるをのゝすみかま",
   "kana": "",
   "speaker": "勝光",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "まをのゝすみかま勝光"
  },
  {
   "seq": "59",
   "text": "うす雪はちりかふねやのかへなからさらぬしるしやかつみ火のもと",
   "kana": "",
   "speaker": "親長",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ううつみひ親長",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "月や先ねやもるいろにうつみ火のかけさへしらむさゆる夜ころは",
   "kana": "",
   "speaker": "為富",
   "page": 9,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "つ",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "みるう地にきゆるは霜やかさぬらむはたさへさむきうつみ火のもと",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "みうつ見ひ貞隆",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "ひとりわかおきゐる床にうつみ火のきえぬを友とむかふ夜半かな",
   "kana": "",
   "speaker": "長興",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ひ○うつみひ長興",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "なきもせすねてのあさまのおも顔にむかふや人のかたみなからん",
   "kana": "",
   "speaker": "為信",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "おおもかけに為信",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "もろともにみし夜の空は秋ふけてなをおもか気にむかぬ月かな",
   "kana": "",
   "speaker": "賢盛",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "もおもかけに賢盛",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "かきりあらはめくりやあはむおも顔にとくるとみゆる人のした紐",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ゆおもかけに教国",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "けふいく夜うきぬる日まもなけきわひうきおも影に恋つゝそふる",
   "kana": "",
   "speaker": "義政",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "け松もかけに義政",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "にほひをはわかれし袖のおもかけにのこして人の猶したへとや",
   "kana": "",
   "speaker": "玄就",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "おもかけ",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "こよひさへふ気行中のいつはりに恋わひぬとはさすかしるらし",
   "kana": "",
   "speaker": "ぬ中薫",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "こひわひ",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "日にそへて猶こひわひぬ夕をもわするゝ人にせめてつけめや",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "むこひわひぬ為富",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "わりなしやつらき心のほとをなと我のみかくはこひわひぬらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "こひわひぬ",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "一すちにうき身をしれはいまさらに恋わひぬとも元こそもらさね",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ひこひわひぬ季春",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "ぬれて月すひまもなみたの袖をみよこひわひぬとはしるき物から",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ぬこひわひぬ数秀",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "うくつらき鳥かねよりや小筵にうちもねすかの衣々のうら",
   "kana": "",
   "speaker": "貞宗",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "うちもねす貞宗",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "千世をふるおもひもかくや一夜たにうちもねす待こゝろつくしは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ちうちもねす雅康",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "物おもふ夜半のまくらにうちねす千々に心をくたくとをしれ",
   "kana": "",
   "speaker": "す雅行",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "うちもね",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "ねぬなわのなかきよなからうちもねすあかせみ心むすほゝれつゝ",
   "kana": "",
   "speaker": "す明茂",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ねうちも放",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "すゑよいかに夢さへたえていたつゝにうちもねすのみなけく契は",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "すうちもねす",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "秋の夜の霜と見るまて暁は月もすゝしきかねのこゑかなしあかつきは為富冨",
   "kana": "",
   "speaker": "長興",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ああかつきは",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "かけたのひ君につかふる暁はほしをいたゝく人そひまなき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ああかつきは",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "つもりこし身のつみとかもね覚してうきあかつきはなけきそへつゝ",
   "kana": "",
   "speaker": "雅康",
   "page": 11,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "なかつきは雅康",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "きかはやな高野のてらのかねておもふ其あかつきははるかなれとも",
   "kana": "",
   "speaker": "義政",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "し",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "春秋の花と月とをときなりて見はてぬ夢の暁はうし",
   "kana": "",
   "speaker": "之親",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "あかつきは之親",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "月影もやとりて袖の露ふかしあかつきおきの水むすふ手に",
   "kana": "",
   "speaker": "顕豪",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "つつゆふかし顕豪",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "ゆふされはきくもうつらの野と成てなを露ふかしふか草の里",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ゆつゆふかし英基",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "ふりにけにうき身の袖のつゆふかしかくはかりやは秋の草葉も",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ふつゆふかし昨慶",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "か羅衣をく露ふかしはる〳〵ときつゝなれぬる草のまくらに",
   "kana": "",
   "speaker": "明宣",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "つゆふかし",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "霞嶋の道にめくみの露ふかし神や屋はらく光そへけん",
   "kana": "",
   "speaker": "綱光",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "つゆふかし",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "おこたらす思ふ事とていつる身に見かくこと葉の玉はしま姫",
   "kana": "",
   "speaker": "雅康",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "おおもふこと",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "百舟のかす〳〵見へておもふことけふ見つしほのわかのうら風",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一おもふこと長恒",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "ふるき代にかへりてなきやみかゝなんおもふことみの玉つしま姫",
   "kana": "",
   "speaker": "親長",
   "page": 12,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ふ一おもふこと親長"
  },
  {
   "seq": "91",
   "text": "こゝろをもくらへぬ人を我のみにおもふことこそおろかなりけれは",
   "kana": "",
   "speaker": "勝光",
   "page": 13,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ことおもふこと勝光"
  },
  {
   "seq": "92",
   "text": "とにかくにおもふことなき時にあひて君かなとせをあふかさらめや",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "おもふこと",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "なをそうき老のね覚をなくさめし月より後のなかしてふよは",
   "kana": "",
   "speaker": "持通",
   "page": 16,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "右八首闕百首作者中川細川家人池田新左衛門尉小槻宿称以上三十二人仮名百首短冊寸法上ヨリ五分折本寸法白地錦七十代大膳大夫俊昭也正月十四日入後慕月"
  },
  {
   "seq": "94",
   "text": "月のみやそらにしるらん待焼て秋の最中にかゝる心を",
   "kana": "",
   "speaker": "道永",
   "page": 16,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "兼待十五夜",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "けふといへは暮ぬさきよりそらはれてなかみの月はかねてしるしも",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "兼待十五夜",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "おとこ山岸にゆふなる雲きへてそらに名たかき月そ待るゝ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-733735",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十五夜夕禅空",
   "kotobagaki": ""
  }
 ],
